#!/usr/bin/env sh

set -u

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
NX_LITE_HOME=${NX_LITE_HOME:-$HOME/.nx-lite}
NX_LITE_RAW_BASE=${NX_LITE_RAW_BASE:-https://raw.githubusercontent.com/Nuxoul/nx-lite/main}
DEFAULT_MODULES="base64 base64-enc base64-dec angle color guid hash json json-pretty pow2 url url-enc url-dec md5"
if [ -f "$script_dir/../lib/nx/core.sh" ]; then
  NX_LITE_SOURCE_ROOT=$(CDPATH= cd -- "$script_dir/.." && pwd)
  NX_LITE_RUNTIME_DIR=$NX_LITE_SOURCE_ROOT/lib/nx
else
  NX_LITE_SOURCE_ROOT=
  NX_LITE_RUNTIME_DIR=${NX_LITE_RUNTIME_DIR:-$NX_LITE_HOME/runtime}
fi
export NX_LITE_SOURCE_ROOT NX_LITE_RUNTIME_DIR

activate_pending_runtime() {
  pending="$NX_LITE_HOME/runtime.next"
  if [ -d "$pending" ]; then
    old="$NX_LITE_HOME/runtime.previous.$$"
    mv "$NX_LITE_RUNTIME_DIR" "$old" 2>/dev/null || true
    mv "$pending" "$NX_LITE_RUNTIME_DIR" || {
      [ -d "$old" ] && mv "$old" "$NX_LITE_RUNTIME_DIR"
      return 1
    }
    rm -rf "$old"
  fi
}

bootstrap_runtime() {
  mkdir -p "$NX_LITE_RUNTIME_DIR" || return 1
  for runtime_file in core.sh ui.sh default-modules.sh lifecycle.sh; do
    target="$NX_LITE_RUNTIME_DIR/$runtime_file"
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL "${NX_LITE_RAW_BASE%/}/lib/nx/$runtime_file" -o "$target" || return 1
    elif command -v wget >/dev/null 2>&1; then
      wget -qO "$target" "${NX_LITE_RAW_BASE%/}/lib/nx/$runtime_file" || return 1
    else
      return 1
    fi
    chmod +x "$target" || return 1
  done
}

activate_pending_runtime || {
  printf 'nx: failed to activate the pending runtime update\n' >&2
  exit 1
}

if [ ! -f "$NX_LITE_RUNTIME_DIR/core.sh" ] ||
  [ ! -f "$NX_LITE_RUNTIME_DIR/lifecycle.sh" ]; then
  bootstrap_runtime || {
    printf 'nx: runtime is not installed: %s\n' "$NX_LITE_RUNTIME_DIR" >&2
    printf 'Run the installer or check NX_LITE_RAW_BASE.\n' >&2
    exit 1
  }
fi

for runtime_file in core.sh ui.sh default-modules.sh lifecycle.sh; do
  if [ ! -f "$NX_LITE_RUNTIME_DIR/$runtime_file" ]; then
    printf 'nx: missing runtime file: %s\n' "$NX_LITE_RUNTIME_DIR/$runtime_file" >&2
    printf 'Run the installer or nx upgrade to repair nx-lite.\n' >&2
    exit 1
  fi
  . "$NX_LITE_RUNTIME_DIR/$runtime_file"
done

main "$@"
